# Copy to .env locally. Never commit .env or service-account files.
NODE_ENV=development
PORT=5001
# Set a stable random secret >=32 chars (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
DEVICE_COOKIE_SECRET=
# Absolute path to a securely mounted Firebase Admin service-account file; or host-provided ADC.
GOOGLE_APPLICATION_CREDENTIALS=
GCLOUD_PROJECT=
# Owner-confirmed venue pin (also the application defaults). Override both together.
VENUE_LATITUDE=12.912773610440954
VENUE_LONGITUDE=77.62322878099566
VENUE_RADIUS_METERS=100
VENUE_MAX_ACCURACY_METERS=50
REQUIRE_ROOM_CODE=true
# Prefer one origin in production. Optional exact comma-separated origins for development only.
ALLOWED_ORIGINS=
# Set only to your host's documented number of trusted reverse proxies.
TRUST_PROXY_HOPS=0

# Passkeys verify phone user presence. Fingerprint/face templates are never collected.
# Deployment must set this to your application's stable HTTPS hostname (no scheme).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_EXPECTED_ORIGINS=http://localhost:3000,http://localhost:5001
ANDROID_APP_ID=in.shikshavertex.attendance
# Comma-separated SHA-256 signing certificate fingerprints; never private signing keys.
ANDROID_SHA256_CERT_FINGERPRINTS=

# Optional additional Wi-Fi restrictions; the required SSID is Shikshavertex_5G.
# These are PUBLIC router/network identifiers, never the Wi-Fi password.
# Comma-separated access point BSSIDs, e.g. aa:bb:cc:dd:ee:ff (include each approved AP/radio).
WIFI_ATTENDANCE_BSSIDS=
# Optional venue public egress IPs; configure TRUST_PROXY_HOPS correctly for your host first.
WIFI_ATTENDANCE_ALLOWED_IPS=

# Explicit first HR mailbox. Verified ownership is required; bootstrap runs only once.
# Set empty to disable bootstrap; changing this cannot replace an already provisioned administrator.
HR_ADMIN_EMAIL=hr@shikshavertex.in

# Temporary setup: false permits approved self check-in without venue, GPS, Wi-Fi or room code.
# Set true in Render to re-enable those physical-presence checks.
ENFORCE_ONSITE_ATTENDANCE=false

# Owner-selected, verified attendance viewers. Empty disables these grants.
# This does not grant HR or access to another employee's movement history.
ATTENDANCE_VIEWER_EMAILS=hr@shikshavertex.in,surya_deekshith@shikshavertex.in,hr_pallavi@shikshavertex.in
